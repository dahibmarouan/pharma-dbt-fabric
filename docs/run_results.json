e": "compile", "started_at": "2026-08-08T19:12:42.722552Z", "completed_at": "2026-08-08T19:12:42.745108Z"}, {"name": "execute", "started_at": "2026-08-08T19:12:42.747106Z", "completed_at": "2026-08-08T19:12:42.747106Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.032553911209106445, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.pharma_project.relationships_int_openfda__reactions_deduped_report_id__report_id__ref_int_openfda__adverse_events_deduped_.f81e9a470d", "compiled": true, "compiled_code": "\n    \n    \n\nwith child as (\n    select report_id as from_field\n    from \"warehouse\".\"main\".\"int_openfda__reactions_deduped\"\n    where report_id is not null\n),\n\nparent as (\n    select report_id as to_field\n    from \"warehouse\".\"main\".\"int_openfda__adverse_events_deduped\"\n)\n\nselect\n    from_field\n\nfrom child\nleft join parent\n    on child.from_field = parent.to_field\n\nwhere parent.to_field is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-08T19:12:42.716553Z", "completed_at": "2026-08-08T19:12:42.745108Z"}, {"name": "execute", "started_at": "2026-08-08T19:12:42.747106Z", "completed_at": "2026-08-08T19:12:42.747106Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.0335538387298584, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.pharma_project.fct_reaction_adverse_events", "compiled": true, "compiled_code": "select\n    reactions.report_id,\n    reactions.reaction_name,\n    adverse_events.received_date,\n    adverse_events.is_serious,\n    adverse_events.patient_age,\n    adverse_events.patient_sex_code\nfrom \"warehouse\".\"main\".\"int_openfda__reactions_deduped\" as reactions\ninner join \"warehouse\".\"main\".\"int_openfda__adverse_events_deduped\" as adverse_events\n    on reactions.report_id = adverse_events.report_id", "relation_name": "\"warehouse\".\"main\".\"fct_reaction_adverse_events\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-08T19:12:42.734552Z", "completed_at": "2026-08-08T19:12:42.746109Z"}, {"name": "execute", "started_at": "2026-08-08T19:12:42.748106Z", "completed_at": "2026-08-08T19:12:42.748106Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.03255271911621094, "adapter_response": {}, "message": null, "failures": null, "unique_id": "analysis.pharma_project.scratch", "compiled": true, "compiled_code": "-- Pour les 5 m\u00e9dicaments les plus associ\u00e9s \u00e0 des cas graves,\n-- quelles sont leurs 3 r\u00e9actions les plus fr\u00e9quentes ?\n-- (quelles paires m\u00e9dicament/r\u00e9action reviennent le plus souvent ensemble)\n\nwith drug_reactions as (\n    select\n        drugs.drug_name,\n        reactions.reaction_name,\n        count(*) as frequence\n    from \"warehouse\".\"main\".\"int_openfda__drugs_deduped\" as drugs\n    inner join \"warehouse\".\"main\".\"int_openfda__reactions_deduped\" as reactions\n        on drugs.report_id = reactions.report_id\n    group by drugs.drug_name, reactions.reaction_name\n),\n\ndrug_totals as (\n    select drug_name, sum(frequence) as total_mentions\n    from drug_reactions\n    group by drug_name\n    order by total_mentions desc\n    limit 5\n),\n\nranked as (\n    select\n        drug_reactions.drug_name,\n        drug_totals.total_mentions,\n        drug_reactions.reaction_name,\n        drug_reactions.frequence,\n        row_number() over (\n            partition by drug_reactions.drug_name\n            order by drug_reactions.frequence desc\n        ) as rang\n    from drug_reactions\n    inner join drug_totals\n        on drug_reactions.drug_name = drug_totals.drug_name\n)\n\nselect drug_name, total_mentions, reaction_name, frequence\nfrom ranked\nwhere rang <= 3\norder by total_mentions desc, frequence desc", "relation_name": null, "batch_res